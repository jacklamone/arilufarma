# ═══════════════════════════════════════════════════════════════════
# ArilùFarma · Assistente WhatsApp — variabili d'ambiente
#
# Copia questo file in ".env" SOLO sul VPS e compilalo lì.
# ⚠️ NON committare mai il file .env: contiene le chiavi segrete.
# ═══════════════════════════════════════════════════════════════════

# ── Dominio pubblico del bot (record DNS di tipo A → IP del VPS) ──
BOT_DOMAIN=bot.parafarmaciasassari.it

# ── Chiave di cifratura di n8n ──
# Genera con:  openssl rand -hex 32
# ⚠️ Non cambiarla mai dopo il primo avvio (renderebbe illeggibili le credenziali salvate).
N8N_ENCRYPTION_KEY=

# ── Meta / WhatsApp Cloud API ──
# Token di verifica del webhook: una stringa qualsiasi inventata da te
# (genera con: openssl rand -hex 16). Va incollata identica su Meta.
META_VERIFY_TOKEN=

# Token di accesso PERMANENTE (da un System User in Meta Business Suite,
# NON il token temporaneo di 24h che scade). Vedi README, passo 5.
META_ACCESS_TOKEN=

# "ID numero di telefono" del numero WhatsApp (lo trovi in
# developers.facebook.com → la tua app → WhatsApp → Configurazione API).
# NON è il numero di telefono: è un ID numerico lungo.
META_PHONE_NUMBER_ID=

# Versione della Graph API (lascia così se non hai motivi per cambiarla).
META_API_VERSION=v20.0

# ── Notifiche al titolare ──
# Numero WhatsApp del Dott. Conti in formato internazionale SENZA "+"
# (es. 393271234567). Lascia vuoto per disattivare le notifiche.
TITOLARE_WA_ID=

# Nome del template Meta approvato per le notifiche al titolare
# (vedi README, passo 5.6). Se vuoto, il bot prova con un messaggio
# normale: arriva solo se il titolare ha scritto al bot nelle ultime 24h.
META_TEMPLATE_NOTIFICA=

# ── Google ──
# ID del foglio Google (la parte lunga nell'URL del foglio, tra /d/ e /edit).
GOOGLE_SHEET_ID=

# ID del calendario Google (Impostazioni calendario → "ID calendario";
# per il calendario principale è l'indirizzo Gmail dell'account).
GOOGLE_CALENDAR_ID=
